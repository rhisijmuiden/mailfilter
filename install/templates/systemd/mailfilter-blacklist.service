[Unit]
Description=Mailfilter: check this server's addresses against DNS blocklists
Documentation=https://github.com/rhisijmuiden/mailfilter
After=network-online.target unbound.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=PYTHONPATH={{MF_SRC}}/backend
# Exit code 2 means "listed"; that is a result, not a failure of the check
SuccessExitStatus=2
ExecStart=/usr/bin/python3 -m mailfilter_dns blacklist --update
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mailfilter
