# Managed by Mailfilter. How the web interface is reached is chosen in the
# installer (--web-mode) or under System > Web access: {{WEB_MODE}}.
{
	admin off
{{CADDY_GLOBAL}}
	servers {
		protocols h1 h2 h3
{{CADDY_SERVERS}}
	}
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}
}

(mailfilter_app) {
	encode zstd gzip
	import security_headers
	# API (FastAPI, mailfilter-web.service). Behind a reverse proxy, Caddy keeps the
	# proxy's X-Forwarded-For (trusted_proxies above) and uvicorn trusts it
	# (FORWARDED_ALLOW_IPS in /etc/mailfilter/web.env).
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	# Click links in incoming mail (link protection): checked by the web app at the click.
	handle /l/* {
		reverse_proxy 127.0.0.1:8000
	}
	# The interface prototype stays available for reference.
	handle_path /prototype/* {
		root * {{MF_SRC}}/prototype
		file_server
	}
	# Web interface (React, built into frontend/dist). Unknown paths load the app.
	handle {
		root * {{MF_SRC}}/frontend/dist
		@assets path /assets/* /fonts/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# index.html and theme.js are not fingerprinted: always ask, so an update
		# shows up right away (unchanged files still come back as 304).
		@pages not path /assets/* /fonts/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{{WEB_SITES}}
