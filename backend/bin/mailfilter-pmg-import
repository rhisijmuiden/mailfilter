#!/bin/sh
# Imports a Proxmox Mail Gateway backup. Run as root (the web app uses sudo).
# -I keeps the environment and current directory out of Python's import path.
exec python3 -I -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from mailfilter_pmg.__main__ import main; sys.exit(main(sys.argv[1:]))' \
  "$(dirname "$(readlink -f "$0")")/.." "$@"
